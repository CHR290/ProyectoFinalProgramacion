<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="uniquindio.edu.co.proyectofinal.controller.FuncionController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Button text="Volver al menú" onAction="#volverAlMenu" />
                <Button text="Películas" onAction="#irAPeliculas" />
                <Button text="Salas" onAction="#irASalas" />
                <Label text="Administración de funciones"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            </children>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tablaFunciones">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="70.0" text="Código" />
                <TableColumn fx:id="colPelicula" prefWidth="200.0" text="Película" />
                <TableColumn fx:id="colSala" prefWidth="120.0" text="Sala" />
                <TableColumn fx:id="colFecha" prefWidth="100.0" text="Fecha" />
                <TableColumn fx:id="colHora" prefWidth="80.0" text="Hora" />
                <TableColumn fx:id="colValorBase" prefWidth="100.0" text="Valor base" />
                <TableColumn fx:id="colDisponibles" prefWidth="100.0" text="Disponibles" />
                <TableColumn fx:id="colEstado" prefWidth="110.0" text="Estado" />
            </columns>
        </TableView>
    </center>
    <right>
        <VBox prefWidth="260.0" spacing="8.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label text="Película" />
                <ComboBox fx:id="cmbPelicula" maxWidth="Infinity" />
                <Label text="Sala" />
                <ComboBox fx:id="cmbSala" maxWidth="Infinity" />
                <Label text="Fecha" />
                <DatePicker fx:id="dpFecha" maxWidth="Infinity" />
                <Label text="Hora (HH:mm)" />
                <TextField fx:id="txtHora" />
                <Label text="Valor base" />
                <TextField fx:id="txtValorBase" />
                <Button maxWidth="Infinity" text="Programar función" onAction="#programarFuncion" />
                <Button fx:id="btnCancelar" maxWidth="Infinity" text="Cancelar seleccionada"
                        onAction="#cancelarFuncion" />
                <Button fx:id="btnFinalizar" maxWidth="Infinity" text="Finalizar seleccionada"
                        onAction="#finalizarFuncion" />
                <Button maxWidth="Infinity" text="Limpiar formulario" onAction="#limpiarFormulario" />
                <Label fx:id="lblMensaje" wrapText="true" />
            </children>
        </VBox>
    </right>
</BorderPane>