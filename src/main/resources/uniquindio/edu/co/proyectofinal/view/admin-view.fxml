<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="550.0" prefWidth="950.0"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="uniquindio.edu.co.proyectofinal.controller.AdminController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Button text="Volver al menú" onAction="#volverAlMenu" />
                <Button text="Salas" onAction="#irASalas" />
                <Label text="Administración de películas"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            </children>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tablaPeliculas">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre" />
                <TableColumn fx:id="colGenero" prefWidth="160.0" text="Género" />
                <TableColumn fx:id="colDuracion" prefWidth="100.0" text="Duración (min)" />
                <TableColumn fx:id="colClasificacion" prefWidth="130.0" text="Clasificación" />
                <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
            </columns>
        </TableView>
    </center>
    <right>
        <VBox prefWidth="260.0" spacing="8.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label text="Nombre" />
                <TextField fx:id="txtNombre" />
                <Label text="Género" />
                <TextField fx:id="txtGenero" />
                <Label text="Duración (minutos)" />
                <TextField fx:id="txtDuracion" />
                <Label text="Clasificación" />
                <ComboBox fx:id="cmbClasificacion" maxWidth="Infinity" />
                <Button maxWidth="Infinity" text="Registrar" onAction="#registrarPelicula" />
                <Button maxWidth="Infinity" text="Modificar seleccionada" onAction="#modificarPelicula" />
                <Button fx:id="btnHabilitar" maxWidth="Infinity" text="Habilitar seleccionada"
                        onAction="#habilitarPelicula" />
                <Button fx:id="btnDeshabilitar" maxWidth="Infinity" text="Deshabilitar seleccionada"
                        onAction="#deshabilitarPelicula" />
                <Button maxWidth="Infinity" text="Limpiar formulario" onAction="#limpiarFormulario" />
                <Label fx:id="lblMensaje" wrapText="true" />
            </children>
        </VBox>
    </right>
</BorderPane>
