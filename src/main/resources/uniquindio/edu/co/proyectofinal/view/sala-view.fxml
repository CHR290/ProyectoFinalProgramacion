<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="550.0" prefWidth="950.0"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="uniquindio.edu.co.proyectofinal.controller.SalaController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Button text="Volver al menú" onAction="#volverAlMenu" />
                <Button text="Películas" onAction="#irAPeliculas" />
                <Label text="Administración de salas"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            </children>
        </HBox>
    </top>
    <center>
        <TableView fx:id="tablaSalas">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="260.0" text="Nombre" />
                <TableColumn fx:id="colCapacidad" prefWidth="120.0" text="Capacidad" />
                <TableColumn fx:id="colEstado" prefWidth="160.0" text="Estado" />
            </columns>
        </TableView>
    </center>
    <right>
        <VBox prefWidth="260.0" spacing="8.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <Label text="Nombre" />
                <TextField fx:id="txtNombre" />
                <Label text="Capacidad (asientos)" />
                <TextField fx:id="txtCapacidad" />
                <Button maxWidth="Infinity" text="Registrar" onAction="#registrarSala" />
                <Button maxWidth="Infinity" text="Modificar seleccionada" onAction="#modificarSala" />
                <Button fx:id="btnHabilitar" maxWidth="Infinity" text="Habilitar seleccionada"
                        onAction="#habilitarSala" />
                <Button fx:id="btnDeshabilitar" maxWidth="Infinity" text="Deshabilitar seleccionada"
                        onAction="#deshabilitarSala" />
                <Button maxWidth="Infinity" text="Limpiar formulario" onAction="#limpiarFormulario" />
                <Label fx:id="lblMensaje" wrapText="true" />
            </children>
        </VBox>
    </right>
</BorderPane>